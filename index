<script>
const defaultProducts=[
{id:"p1",name:"Glutathione 1500mg",category:"glutathione",description:"Explore product details and available order options.",price:"",image:"",active:true},
{id:"p2",name:"Holy Grail Blend",category:"blend",description:"Explore product details and available order options.",price:"",image:"",active:true},
{id:"p3",name:"Beauty Blend",category:"beauty",description:"Explore product details and available order options.",price:"",image:"",active:true},
{id:"p4",name:"Korean Glutaone",category:"glutathione",description:"Explore product details and available order options.",price:"",image:"",active:true}
];
function loadProducts(){try{let p=JSON.parse(localStorage.getItem("sd_products")||"null");return Array.isArray(p)?p:defaultProducts}catch(e){return defaultProducts}}
function render(){let list=loadProducts().filter(p=>p.active!==false);let q=(document.getElementById("search").value||"").toLowerCase();let cat=document.getElementById("category").value;list=list.filter(p=>(p.name+" "+(p.description||"")).toLowerCase().includes(q)&&(cat==="all"||p.category===cat));let root=document.getElementById("products");root.innerHTML="";if(!list.length){root.innerHTML='<div class="empty">No products found. Try another search.</div>';return}
list.forEach(p=>{let c=document.createElement("article");c.className="card";let visual=p.image?'<img src="'+p.image+'" alt="">':'<div class="miniVial">SEXY DUST<br>PEPTIDE</div>';c.innerHTML='<div class="productImg">'+visual+'</div><h3></h3><p class="desc"></p><div class="price"></div><div class="cardBtns"><button class="pill" type="button">View Details</button><button class="pill primary" type="button">Add to Cart</button></div>';c.querySelector("h3").textContent=p.name;c.querySelector(".desc").textContent=p.description||"View product details and order options.";c.querySelector(".price").textContent=p.price||"View for pricing";c.querySelectorAll("button")[0].onclick=()=>alert(p.name+"\\n\\n"+(p.description||"Product details")+(p.price?"\\nPrice: "+p.price:"")+"\\n\\nOrder options: Vial + Bacteriostatic Water Only / Complete Set.");c.querySelectorAll("button")[1].onclick=()=>alert("Product: "+p.name+"\\nNext step: connect checkout and order processing.");root.appendChild(c)})}
document.getElementById("search").addEventListener("input",render);document.getElementById("category").addEventListener("change",render);document.getElementById("year").textContent=new Date().getFullYear();window.addEventListener("storage",e=>{if(e.key==="sd_products"||e.key==="sd_logo")render()});try{let l=localStorage.getItem("sd_logo");if(l)document.getElementById("brandLogo").src=l}catch(e){}
function applyAdminSettings(){try{const s=JSON.parse(localStorage.getItem("sd_settings")||"{}");
if(s.payment&&(s.payment.qr||s.payment.instructions)){const box=document.getElementById("publicPayment");box.classList.remove("hidden");document.getElementById("publicPaymentLabel").textContent=s.payment.label||"Payment Instructions";document.getElementById("publicPaymentText").textContent=s.payment.instructions||"";if(s.payment.qr){const im=document.getElementById("publicPaymentQR");im.src=s.payment.qr;im.classList.remove("hidden")}}
const pg=document.getElementById("proofGallery");if(pg&&Array.isArray(s.proofs)){pg.innerHTML="";const visible=s.proofs.filter(x=>x.active);if(!visible.length)pg.innerHTML='<div class="proofEmpty">No buyer’s proof has been published yet.</div>';visible.forEach(x=>{const wrap=document.createElement("div");const im=document.createElement("img");im.src=x.image;im.alt=x.caption||"Buyer’s Proof";const cap=document.createElement("p");cap.className="smallNote";cap.textContent=x.caption||"";wrap.append(im,cap);pg.append(wrap)})}
const prot=document.getElementById("publicProtocols");if(prot&&Array.isArray(s.protocols)){prot.innerHTML="";if(!s.protocols.length)prot.innerHTML='<p class="smallNote">No protocol information has been published yet.</p>';s.protocols.forEach(x=>{const card=document.createElement("div");card.className="protocolCard";const title=document.createElement("h3");title.textContent=x.title;const body=document.createElement("p");body.textContent=x.content||"";card.append(title,body);if(x.link){const a=document.createElement("a");a.className="pill";a.href=x.link;a.target="_blank";a.rel="noopener noreferrer";a.textContent="Open document";card.append(a)}prot.append(card)})}
const links=document.getElementById("publicContactLinks");if(links&&s.contact){links.innerHTML="";let url=s.contact.waLink|| (s.contact.waNumber?"https://wa.me/"+s.contact.waNumber:"");if(url){const a=document.createElement("a");a.className="pill primary";a.href=url;a.target="_blank";a.rel="noopener noreferrer";a.textContent=s.contact.waLabel||"Chat with us on WhatsApp";links.append(a)}if(s.contact.otherLink){const a=document.createElement("a");a.className="pill";a.href=s.contact.otherLink;a.target="_blank";a.rel="noopener noreferrer";a.textContent="Community / Contact";links.append(a)}}
}catch(e){console.warn("Could not load store settings",e)}}
window.addEventListener("storage",applyAdminSettings);applyAdminSettings();render();
